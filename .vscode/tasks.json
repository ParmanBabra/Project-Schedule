{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: all (backend + frontend)",
      "dependsOn": ["dev: backend", "dev: frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "dev: backend",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": ["-m", "uvicorn", "app.main:app", "--reload", "--port", "8000"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "group": "dev", "reveal": "always" },
      "problemMatcher": {
        "pattern": { "regexp": "^(.*)$", "file": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started server process",
          "endsPattern": "Application startup complete"
        }
      }
    },
    {
      "label": "dev: frontend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "group": "dev", "reveal": "always" },
      "problemMatcher": {
        "pattern": { "regexp": "^(.*)$", "file": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "test: all",
      "dependsOn": ["test: backend", "test: frontend unit"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "test: backend",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": ["-m", "pytest"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "presentation": { "panel": "dedicated", "group": "test" },
      "problemMatcher": []
    },
    {
      "label": "test: frontend unit",
      "type": "shell",
      "command": "npm",
      "args": ["run", "test"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "panel": "dedicated", "group": "test" },
      "problemMatcher": []
    },
    {
      "label": "test: frontend watch",
      "type": "shell",
      "command": "npm",
      "args": ["run", "test:watch"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "group": "test" },
      "problemMatcher": []
    },
    {
      "label": "test: e2e (playwright)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "test:e2e"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "panel": "dedicated", "group": "test" },
      "problemMatcher": []
    },
    {
      "label": "design: shots (ถ่ายภาพทุกหน้า + mockup)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "shots"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "panel": "dedicated", "group": "design" },
      "problemMatcher": []
    },
    {
      "label": "design: visual regression",
      "type": "shell",
      "command": "npm",
      "args": ["run", "test:visual"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "panel": "dedicated", "group": "design" },
      "problemMatcher": []
    },
    {
      "label": "design: approve baseline",
      "type": "shell",
      "command": "npm",
      "args": ["run", "visual:approve"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "panel": "dedicated", "group": "design" },
      "problemMatcher": []
    },
    {
      "label": "lint: all",
      "dependsOn": ["lint: backend", "lint: frontend"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "lint: backend",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": ["-m", "ruff", "check", "."],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "lint: frontend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "lint"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    }
  ]
}
