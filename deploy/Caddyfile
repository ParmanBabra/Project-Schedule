{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8000 {
		header_up X-Forwarded-Proto {scheme}
	}
	header {
		# the app sets its own security headers; Caddy adds HTTPS-only ones
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output stdout
		format console
	}
}
